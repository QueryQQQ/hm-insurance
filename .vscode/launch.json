{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 agent-service (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "cwd": "${workspaceFolder}/agent-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent-service"
      },
      "envFile": "${workspaceFolder}/agent-service/.env",
      "python": "${workspaceFolder}/agent-service/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
